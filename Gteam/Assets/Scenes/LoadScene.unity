--- !u!114 &234615811
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 234615809}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5abf340a66f0be14793686b401f37f60, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  titleText: {fileID: 702934405}
  messageText: {fileID: 621732079}
  tips:
  - title: "\u5B87\u5B99\u30C7\u30D6\u30EA\u306E\u901F\u5EA6"
    message: "\u5B87\u5B99\u30C7\u30D6\u30EA\u306F\u6642\u901F\u7D0428,000km\u3067\u98DB\u884C\u3057\u3066\u3044\u308B\u3002\n\u5C0F\u3055\u306A\u30CD\u30B81\u672C\u3067\u3082\u4EBA\u5DE5\u885B\u661F\u306B\u6DF1\u523B\u306A\u30C0\u30E1\u30FC\u30B8\u3092\u4E0E\u3048\u308B\u5371\u967A\u304C\u3042\u308B\u3002"
  - title: "\u5B87\u5B99\u30C7\u30D6\u30EA\u306E\u6570"
    message: "\u5730\u7403\u306E\u5468\u56F2\u306B\u306F\u81A8\u5927\u306A\u6570\u306E\u5B87\u5B99\u30C7\u30D6\u30EA\u304C\u5B58\u5728\u3057\u3066\u3044\u308B\u3002\n\u305D\u306E\u305F\u3081\u4E16\u754C\u4E2D\u3067\u56DE\u53CE\u6280\u8853\u3084\u76E3\u8996\u30B7\u30B9\u30C6\u30E0\u306E\u7814\u7A76\u304C\u9032\u3081\u3089\u308C\u3066\u3044\u308B\u3002"
  - title: "\u30C7\u30D6\u30EA\u540C\u58EB\u306E\u885D\u7A81"
    message: "\u5B87\u5B99\u30C7\u30D6\u30EA\u540C\u58EB\u304C\u885D\u7A81\u3059\u308B\u3068\u3055\u3089\u306B\u591A\u304F\u306E\u30C7\u30D6\u30EA\u304C\u767A\u751F\u3059\u308B\u3002\n\u3053\u308C\u3092\u9632\u3050\u305F\u3081\u306B\u3082\u30C7\u30D6\u30EA\u5BFE\u7B56\u306F\u91CD\u8981\u3067\u3042\u308B\u3002"
  - title: "\u4F7F\u308F\u308C\u306A\u304F\u306A\u3063\u305F\u4EBA\u5DE5\u885B\u661F"
    message: "\u904B\u7528\u3092\u7D42\u3048\u305F\u4EBA\u5DE5\u885B\u661F\u3082\u5B87\u5B99\u30C7\u30D6\u30EA\u3068\u306A\u308B\u3002\n\u653E\u7F6E\u3055\u308C\u305F\u885B\u661F\u306F\u4ED6\u306E\u5B87\u5B99\u6A5F\u306B\u3068\u3063\u3066\u5371\u967A\u306A\u5B58\u5728\u306B\u306A\u308B\u3002"
  - title: "\u30C7\u30D6\u30EA\u76E3\u8996"
    message: "\u5B87\u5B99\u30C7\u30D6\u30EA\u306F\u5730\u4E0A\u304B\u3089\u76E3\u8996\u30FB\u8FFD\u8DE1\u3055\u308C\u3066\u3044\u308B\u3002\n\u885D\u7A81\u306E\u5371\u967A\u304C\u4E88\u6E2C\u3055\u308C\u305F\u5834\u5408\u306F\u56DE\u907F\u884C\u52D5\u304C\u884C\u308F\u308C\u308B\u3002"
  - title: "\u6D41\u308C\u661F\u3068\u306E\u9055\u3044"
    message: "\u6D41\u308C\u661F\u306F\u4E3B\u306B\u5B87\u5B99\u7A7A\u9593\u306E\u5C0F\u3055\u306A\u5929\u7136\u7269\u304C\u5927\u6C17\u570F\u3078\u7A81\u5165\u3057\u305F\u3082\u306E\u3002\n\u5B87\u5B99\u30C7\u30D6\u30EA\u306F\u4EBA\u985E\u304C\u5B87\u5B99\u3078\u9001\u308A\u51FA\u3057\u305F\u4EBA\u5DE5\u7269\u306E\u7834\u7247\u3067\u3042\u308B\u3002"
  - title: "\u8ECC\u9053\u5909\u66F4"
    message: "\u4EBA\u5DE5\u885B\u661F\u3084\u5B87\u5B99\u30B9\u30C6\u30FC\u30B7\u30E7\u30F3\u306F\u30C7\u30D6\u30EA\u3068\u306E\u885D\u7A81\u3092\u907F\u3051\u308B\u305F\u3081\u306B\u8ECC\u9053\u5909\u66F4\u3092\u884C\u3046\u3053\u3068\u304C\u3042\u308B\u3002\n\u5B89\u5168\u306A\u5B87\u5B99\u5229\u7528\u306E\u305F\u3081\u306B\u6B20\u304B\u305B\u306A\u3044\u5BFE\u7B56\u3067\u3042\u308B\u3002"
